    characterSetSelectionMode: 8
    characterSequence: "\u8BF7\u8F6C\u52A8\u5934\u90E8\u3002\u7A97\u5916\u6709\u5149\u900F\u8FDB\u6765\u3002\u53C8\u4E00\u5929\u8FC7\u53BB\u4E86\u2026
      \u8FD9\u4E2A\u623F\u95F4\uFF0C\u597D\u50CF\u8D8A\u6765\u8D8A\u5927\u4E86\u3002
      \u6211\u660E\u660E\u2026 \u5F88\u8BA4\u771F\u4E86\u3002 \u5B57\u597D\u50CF\u5728\u52A8\u2026
      \u4E0D\uFF0C\u662F\u6211\u7684\u773C\u775B\u53C8\u4E0D\u5BF9\u52B2\u4E86\u3002\u5149\u2026
      \u597D\u523A\u773C\u3002\u5916\u9762\u592A\u5435\u4E86\u3002\u5173\u4E0A\uFF01\u5FEB\u5173\u4E0A\uFF01\u90A3\u91CC\u9762\u2026
      \u66FE\u7ECF\u6709\u5F20\u5408\u5F71\u3002\u73B0\u5728\u53EA\u5269\u4E00\u4E2A\u9ED1\u6D1E\u3002\u8981\u6389\u4E0B\u53BB\u4E86\uFF01\u6211\u753B\u4E0D\u51FA\u623F\u95F4\u771F\u5B9E\u7684\u6837\u5B50\u2026
      \r\n\u6216\u8005\u8BF4\uFF0C\u6211\u770B\u5230\u7684\u201C\u771F\u5B9E\u201D\uFF0C\u6CA1\u4EBA\u76F8\u4FE1\u3002\r\n\u8FD9\u662F......\u6211\u7684\u623F\u95F4\u5417\uFF1F\u4E0D\u5BF9\uFF0C\u600E\u4E48\u53D8\u5F97\u8FD9\u4E48\u5927\uFF1F\uFF01\r\n\u2026\u2026\u5988\u5988\uFF1F\u4E0D\u662F\u2026\u2026\u5988\u5988\u4E0D\u662F\u90A3\u6837\u7684\u2026\u2026\r\n\u4F60\u6700\u8FD1\u2026\u2026\u600E\u4E48\u2026\u2026\u8D8A\u6765\u8D8A\u5947\u602A\u2026\u2026\r\n\u53C8\u662F\u5979\u7684\u58F0\u97F3\uFF0C\u6C38\u8FDC\u5728\u6311\u6211\u7684\u6BDB\u75C5\r\n\u4F60\u6700\u8FD1\u600E\u4E48\u8D8A\u6765\u8D8A\u5947\u602A\uFF0C\u662F\u4E0D\u662F\u538B\u529B\u592A\u5927\u4E86\uFF1F\r\n\u7B49\u7B49\uFF0C\u5979\u4E0D\u662F\u5728\u602A\u6211\uFF1F\u662F\u5728\u62C5\u5FC3\u6211\uFF1F\r\n\u4F60\u4EC0\u4E48\u90FD\u4E0D\u8BF4\uFF0C\u6211\u771F\u7684\u4E0D\u77E5\u9053\u8BE5\u600E\u4E48\u5E2E\u4F60\u2026\u2026\r\n\u5988\u5988\u53EA\u662F\u60F3\u77E5\u9053\uFF0C\u4F60\u662F\u4E0D\u662F\u5F88\u96BE\u53D7\u3002\r\n\u6211\u5F80\u540E\u9000\u7684\u65F6\u5019\uFF0C\u90A3\u4E2A\u68AF\u5B50\u597D\u50CF\u53D8\u5927\u4E86\u2026\u2026\u4E5F\u8BB8\u6211\u53EF\u4EE5\u8E29\u7740\u5B83\u4E0A\u53BB\uFF1F\r\n\u6211\u53C8\u8EB2\u5F00\u5988\u5988\u4E86\u3002\r\n\u5979\u7684\u8138\u5728\u6211\u773C\u91CC\u4F1A\u53D8\uFF0C\u53D8\u5F97\u5F88\u5413\u4EBA\u3002\r\n\u6211\u4E0D\u6562\u770B\u5979\uFF0C\u4E0D\u6562\u548C\u5979\u8BF4\u8BDD\u3002\r\n\u5988\u5988\uFF0C\u6211\u597D\u5BB3\u6015\uFF0C\u53EF\u6211\u66F4\u6015\u8BF4\u51FA\u6765\u3002\u6015\u88AB\u5988\u5988\u5F53\u6210\u602A\u7269\u3002\r\n\u8FD9\u4E9B\u662F\u6211\u7684\u4E1C\u897F\u2026\u2026\r\n\u8FD9\u662F\u6211\u5077\u5077\u4E70\u7684\u836F\uFF0C\u836F\u5E97\u7684\u4EBA\u8BF4\uFF0C\u5934\u75BC\u53EF\u4EE5\u5403\u8FD9\u4E2A\u2026\u2026\r\n2
      text 15\_\u201C\u53EF\u662F\u5BF9\u6211\u6CA1\u6709\u7528\uFF0C\u4E16\u754C\u8FD8\u662F\u4F1A\u53D8\u5F62\u2026\u2026\u201D\r\n2
      text 16\_\u201C\u6211\u4E0D\u80FD\u8BA9\u5988\u5988\u53D1\u73B0\u836F\uFF0C\u4E0D\u60F3\u88AB\u5F53\u4F5C\u7CBE\u795E\u75C5\u3002\u201D\r\n\uFF1A2
      text 17\_\u201C\u8FD9\u662F\u90A3\u5E74\u6D77\u8FB9\uFF0C\u6211\u4EEC\u90FD\u5728\u7B11\uFF0C\uFF08\u773C\u7736\u7EA2\u4E86\uFF09\_2
      text 18\u201C\u90A3\u65F6\u5019\u2026\u2026\u4E16\u754C\u662F\u6B63\u5E38\u7684\u3002\u201D\r\n\_2
      text 19\u8389\u8389\uFF1A\u201D\u5982\u679C\u6211\u628A\u8FD9\u4E9B\u7ED9\u5979\u770B...\u5979\u4F1A\u76F8\u4FE1\u6211\u5417\uFF1F\r\n2
      text 20       \u201C\u6211\u5BB3\u6015\uFF0C\u53EF\u662F...\u4E07\u4E00\u5462\uFF1F\u6211\u60F3\u8BD5\u8BD5\u3002\u201C\r\n\_2
      text 21\u53D8\u5F02\u5BB6\u957F\uFF1A\u8389\u8389\uFF0C\u4F60\u8FC7\u6765\u5566\uFF1F\r\n\_2
      text 22\u8389\u8389\uFF1A\u201D\u6211...\u6709\u4E1C\u897F\u60F3\u7ED9\u4F60\u770B...\u201C\r\n\_2
      text 23\u7CFB\u7EDF\uFF1A\u5C06\u836F\u548C\u65E5\u8BB0\u672C\u4EA4\u7ED9\u5988\u5988\r\n\u73A9\u5BB6\u5C06\u5F97\u5230\u7684\u836F\u548C\u65E5\u8BB0\u672C\u7ED9\u53D8\u5F02\u5BB6\u957F\r\n\_\u53D8\u5F02\u5BB6\u957F\uFF1A2
      text 24\_\u201C\u8FD9\u662F\u836F\uFF1F\u65E5\u8BB0\u672C\uFF1F\u4F60\u54EA\u91CC\u4E0D\u8212\u670D\u5417\uFF1F\u600E\u4E48\u4E0D\u544A\u8BC9\u6211\uFF1F\u201D\r\n\_\u8389\u8389\uFF1A2
      text 25\_\u201C\u6211\u2026\u2026\u6211\u770B\u4E1C\u897F\u4F1A\u53D8\u5F62\u2026\u2026\u201D\r\n\_2
      text 26\u201D\u9ED1\u677F\u4E0A\u7684\u5B57\u4F1A\u8DF3\u821E\uFF0C\u5899\u4F1A\u52A8\uFF0C\u5988\u5988\u7684\u8138\u4E5F\u4F1A\u53D8\u2026\u2026\u201C\r\n\_  
      2 text 27\u201D\u6211\u4E0D\u6562\u544A\u8BC9\u4F60\u2026\u2026\u6211\u6015\u4F60\u89C9\u5F97\u6211\u5947\u602A\u2026\u2026\u201D\r\n\u5BB6\u957F\uFF08\u6C89\u9ED8\u4E86\u4E00\u77AC\uFF0C\u58F0\u97F3\u4F9D\u7136\u56F0\u60D1\uFF0C\u4F46\u66F4\u67D4\u8F6F\u4E86\uFF09\uFF1A\r\n\u5BB6\u957F\uFF1A2
      text 28\_\u201C\u4F1A\u2026\u2026\u4F1A\u53D8\u5F62\uFF1F\u201D\r\n\uFF08\u8BED\u6C14\u91CC\u5E26\u7740\u4E00\u4E1D\u96BE\u8FC7\uFF0C\u4F46\u4E0D\u662F\u4E3A\u81EA\u5DF1\uFF0C\u800C\u662F\u4E3A\u5B69\u5B50\uFF09\_\r\n2
